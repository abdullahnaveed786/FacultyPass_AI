# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=facultypass
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres_db:5432/facultypass

# Redis Settings
REDIS_URL=redis://redis_cache:6379/0

# Security Settings
JWT_SECRET=supersecretjwttokenkey123!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Settings
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Kiosk / State Settings
COOLDOWN_SECONDS=900
BIOMETRIC_THRESHOLD=0.45
DUPLICATE_THRESHOLD=0.50

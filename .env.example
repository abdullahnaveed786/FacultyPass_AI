# PostgreSQL Settings (Replace with actual deployment credentials)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@your_postgres_host:5432/your_postgres_db

# Redis Settings (Replace with actual deployment URL)
REDIS_URL=redis://your_redis_host:6379/0

# Security Settings (Generate a strong random hash for JWT_SECRET)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Settings (Required for Admin Dashboard login check)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Resend Email Integration (Required for teacher registration OTP flow)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=your_resend_verified_from_email_here

# Kiosk / State Settings (Non-sensitive defaults)
COOLDOWN_SECONDS=900
BIOMETRIC_THRESHOLD=0.45
DUPLICATE_THRESHOLD=0.50
